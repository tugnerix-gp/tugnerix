# FvwmButtons - MainPanel
#
# FvwmButtons is a powerful module that can be used to build custom
# panels and docks. This config uses FvwmButtons to build the MainPanel.
# The panel contains buttons to switch desks, FvwmPager, a system tray,
# FvwmIconMan (list of running windows), and a clock.
#
# Note - To use the system tray you must have "stalonetray" installed.
#######################

DestroyModuleConfig MainPanel:*

# PipeRead rechnet die Position aus und übergibt die fertige Geometry-Zeile an FVWM
PipeRead 'echo "*MainPanel: Geometry 840x60+\$(( ($[monitor.$[monitor.primary].width] - 840) / 2 ))-0"'

*MainPanel: Colorset 5
*MainPanel: Rows 60
# Wichtig: Die Spalten müssen jetzt genau der neuen Pixelbreite von 840 entsprechen!
*MainPanel: Columns 840
*MainPanel: Frame 0
*MainPanel: Font "xft:Sans:Bold:size=12:antialias=True"


# Time & Date
*MainPanel: (120x60, Swallow DateTime 'Module FvwmScript FvwmScript-DateTime',\
    Frame 0)

# Menu Button
*MainPanel: (60x60, Icon "$[FVWM_USERDIR]/my_icons/logo/Tugnerix1_48.png", \
	     ActiveColorset 12, Action(Mouse 1) Menu MenuFvwmRoot mouse 0-60p -100m-60p, Frame 2)

# Menü direkt über dem Button öffnen
#*MainPanel: (60x60, Icon "$[FVWM_USERDIR]/icons/logo/Tugnerix1_48.png", \
#             ActiveColorset 12, Action(Mouse 1) Menu MenuFvwmRoot Context rectangle $[w.width]x$[w.height]+$[w.x]+$[w.y] o0 o-100m, Frame 2)

# Quick Launch Buttons
*MainPanel: (60x60, Icon "$[FVWM_USERDIR]/looklink/icons/terminal.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec $[infostore.terminal]", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/system-file-manager.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec pcmanfm", Frame 2)

# --- Start: Desk Buttons 2x2 Grid ---
# Der Container ist 240x60 Pixel groß, wird aber intern als 2x2 Grid definiert.
*MainPanel: (240x60, Container(Rows 2, Columns 2, Frame 0))

  # Jeder Button belegt jetzt genau 1 Grid-Zelle (wird automatisch 120x30 Pixel groß)
  *MainPanel: (Id desk0, Title "One", Action (Mouse 1) GotoDesk 0 0, Colorset 11, ActiveColorset 12, Frame 2)
  *MainPanel: (Id desk1, Title "Two", Action (Mouse 1) GotoDesk 0 1, Colorset 15, ActiveColorset 12, Frame 2)
  *MainPanel: (Id desk2, Title "Three", Action (Mouse 1) GotoDesk 0 2, Colorset 16, ActiveColorset 12, Frame 2)
  *MainPanel: (Id desk3, Title "Four", Action (Mouse 1) GotoDesk 0 3, Colorset 9, ActiveColorset 12, Frame 2)

*MainPanel: (End)
# --- End: Desk Buttons 2x2 Grid ---

# Quick Launch Buttons
*MainPanel: (60x60, Icon "looklink/icons/internet-browser.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec $[infostore.webbrowser]", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/internet-mail.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec claws-mail", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/calendar.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec orage", Frame 2)


# --- Start: Systemtray ---
Test (x stalonetray) *MainPanel: (120x60, Frame 0, Swallow(NoClose,UseOld) \
    stalonetray 'Exec exec stalonetray --config "$[FVWM_USERDIR]/cfg/stalonetray.cfg"')
# --- End: Systemtray ---

