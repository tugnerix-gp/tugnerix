# FvwmButtons - MainPanel
#
# FvwmButtons is a powerful module that can be used to build custom
# panels and docks. This config uses FvwmButtons to build the MainPanel.
# The panel contains buttons to switch desks, FvwmPager, a system tray,
# FvwmIconMan (list of running windows), and a clock.
#
# Note - To use the system tray you must have "stalonetray" installed.
#######################


DestroyModuleConfig MainPanel:*
*MainPanel: Geometry $[monitor.$[monitor.primary].width]x48-0+0
*MainPanel: Colorset 12
*MainPanel: Rows 48
*MainPanel: Columns $[monitor.$[monitor.primary].width]
*MainPanel: Frame 0
*MainPanel: Font "xft:Sans:Bold:size=12:antialias=True"

# Menu Button
*MainPanel: (120x48, Icon "$[FVWM_USERDIR]/my_icons/logo/Tugnerix-Logo.png", \
             ActiveColorset 10, Action(Mouse 1) Menu MenuFvwmRoot Root o0 48p, Frame 2)

# Tasks Button
*MainPanel: (100x48, Title "Tasks", ActiveColorset 10, Action(Mouse 1) WindowList Root o0 48p, Frame 2)

# Quick Launch Buttons (6 Stück x 40px = 240px)
*MainPanel: (60x48, Icon "looklink/icons/terminal.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec $[infostore.terminal]", Frame 2)
*MainPanel: (60x48, Icon "looklink/icons/system-file-manager.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec pcmanfm", Frame 2)
*MainPanel: (60x48, Icon "looklink/icons/internet-browser.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec $[infostore.webbrowser]", Frame 2)
*MainPanel: (60x48, Icon "looklink/icons/internet-mail.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec claws-mail", Frame 2)
*MainPanel: (60x48, Icon "looklink/icons/calendar.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec orage", Frame 2)
*MainPanel: (60x48, Icon "looklink/icons/gimp.png", Colorset 12, ActiveColorset 10, Action(Mouse 1) "Exec exec gimp", Frame 2)


# --- RECHNUNG FÜR DEN SPACER ---
# Alle linken Buttons = 580px (120 + 100 + 360)
# Alle rechten Buttons = 400px (120 + 120 + 160)
# Gesamte Buttonbreite = 980px
# Der Spacer bekommt: Monitorbreite minus 980 Pixel
PipeRead 'echo "*MainPanel: ($(( $[monitor.$[monitor.primary].width] - 980 ))x40, Frame 0)"'


# --- Start: Systemtray ---
Test (x stalonetray) *MainPanel: (120x48, Frame 0, Swallow(NoClose,UseOld) \
    stalonetray 'Exec exec stalonetray --config "$[FVWM_USERDIR]/cfg/stalonetray.cfg"')
# --- End: Systemtray ---

# Time & Date
*MainPanel: (120x48, Swallow DateTime 'Module FvwmScript FvwmScript-DateTime', Frame 0)

# Desk Buttons (4 Stück x 40px = 160px)
*MainPanel: (40x40, Id desk0, Title "1", Action (Mouse 1) GotoDesk 0 0, Colorset 11, ActiveColorset 12, Frame 2)
*MainPanel: (40x40, Id desk1, Title "2", Action (Mouse 1) GotoDesk 0 1, Colorset 15, ActiveColorset 12, Frame 2)
*MainPanel: (40x40, Id desk2, Title "3", Action (Mouse 1) GotoDesk 0 2, Colorset 16, ActiveColorset 12, Frame 2)
*MainPanel: (40x40, Id desk3, Title "4", Action (Mouse 1) GotoDesk 0 3, Colorset 9, ActiveColorset 12, Frame 2)
