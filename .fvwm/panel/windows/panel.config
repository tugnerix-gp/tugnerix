# FvwmButtons - MainPanel
#
# FvwmButtons is a powerful module that can be used to build custom
# panels and docks. This config uses FvwmButtons to build the MainPanel.
# The panel contains buttons to switch desks, FvwmPager, a system tray,
# FvwmIconMan (list of running windows), and a clock.
#
# Note - To use the system tray you must have "stalonetray" installed.
#######################


DestroyModuleConfig MainPanel:*
*MainPanel: Geometry $[monitor.$[monitor.primary].width]x52-0-0
*MainPanel: Colorset 5
*MainPanel: Rows 52
*MainPanel: Columns $[monitor.$[monitor.primary].width]
*MainPanel: Frame 0
*MainPanel: Font "xft:Sans:Bold:size=12:antialias=True"

# Menu Button
*MainPanel: (120x52, Icon "$[FVWM_USERDIR]/my_icons/logo/Tugnerix-Logo.png", \
             ActiveColorset 12, Action(Mouse 1) Menu MenuFvwmRoot Root o0 80, Frame 2)

# ----- 6x52 = 312
*MainPanel: (52x52, Icon "looklink/icons/terminal.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec $[infostore.terminal]", Frame 0)
*MainPanel: (52x52, Icon "looklink/icons/system-file-manager.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec pcmanfm", Frame 0)
*MainPanel: (52x52, Icon "looklink/icons/internet-browser.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec $[infostore.webbrowser]", Frame 0)
*MainPanel: (52x52, Icon "looklink/icons/internet-mail.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec claws-mail", Frame 0)
*MainPanel: (52x52, Icon "looklink/icons/calendar.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec orage", Frame 0)
*MainPanel: (52x52, Icon "looklink/icons/gimp.png", Colorset 5, ActiveColorset 12, Action(Mouse 1) "Exec exec gimp", Frame 0)

# --- RECHNUNG FÜR DEN SPACER ---
# Alle linken Buttons = 432px (120 + 312)
# Alle rechten Buttons = 240px (120 + 120)
# Gesamte Buttonbreite = 672px
# --- Start: Icon Man ---
PipeRead 'echo "*MainPanel: ($(( $[monitor.$[monitor.primary].width] - 672))x52,\
    Top, Swallow FvwmIconMan \'Module FvwmIconMan\', Frame 1)"'
# --- End: Icon Man ---


# --- Start: Systemtray ---
Test (x stalonetray) *MainPanel: (120x52, Frame 0, Swallow(NoClose,UseOld) \
    stalonetray 'Exec exec stalonetray --config "$[FVWM_USERDIR]/cfg/stalonetray.cfg"')
# --- End: Systemtray ---

# Time & Date
*MainPanel: (120x52, Swallow DateTime 'Module FvwmScript FvwmScript-DateTime', Frame 0)
