# FvwmButtons - MainPanel
#
# FvwmButtons is a powerful module that can be used to build custom
# panels and docks. This config uses FvwmButtons to build the MainPanel.
# The panel contains buttons to switch desks, FvwmPager, a system tray,
# FvwmIconMan (list of running windows), and a clock.
#
# Note - To use the system tray you must have "stalonetray" installed.
#######################

DestroyModuleConfig MainPanel:*
*MainPanel: Geometry 120x340+0+0
*MainPanel: Colorset 10
#*MainPanel: Rows $[monitor.$[monitor.primary].height]
*MainPanel: Columns 120
*MainPanel: Frame 0
*MainPanel: Font "xft:Sans:Bold:size=12:antialias=True"

# Menu Button
*MainPanel: (120x40, Icon "$[FVWM_USERDIR]/my_icons/logo/Tugnerix-Logo.png", \
	     ActiveColorset 12, Action(Mouse 1) Menu MenuFvwmRoot Root o0+120p 0, Frame2)

# Quick Launch Buttons
*MainPanel: (60x60, Icon "$[FVWM_USERDIR]/looklink/icons/terminal.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec $[infostore.terminal]", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/system-file-manager.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec pcmanfm", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/internet-browser.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec $[infostore.webbrowser]", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/internet-mail.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec claws-mail", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/calendar.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec orage", Frame 2)
*MainPanel: (60x60, Icon "looklink/icons/gimp.png", ActiveColorset 12, \
               Action(Mouse 1) "Exec exec gimp", Frame 2)

# Tasks Button
*MainPanel: (120x30, Title "Tasks", ActiveColorset 12, Action(Mouse 1) WindowList Root o0+120p 220p, Frame2)


# --- Start: Systemtray ---
Test (x stalonetray) *MainPanel: (120x30, Frame 0, Swallow(NoClose,UseOld) \
    stalonetray 'Exec exec stalonetray --config "$[FVWM_USERDIR]/cfg/stalonetray.cfg"')
# --- End: Systemtray ---

# Time & Date
*MainPanel: (120x40, Swallow DateTime 'Module FvwmScript FvwmScript-DateTime',\
    Frame 0)
#*MainPanel: (120x5, Frame 0)
