#############
# 2: Styles #
#############

# Desktops and Pages
#
# Fvwm has both Virtual Desktops and Pages. Each Desktop is built from
# a grid of Pages. The following sets the name of four Desktops and then
# divides each Desktop into a 2x2 grid of Pages that are positioned as
#
#   +---+---+
#   |   |   |
#   +---+---+
#   |   |   |
#   +---+---+
#
DesktopName 0 Desktop 1
DesktopName 1 Desktop 2
DesktopName 2 Desktop 3
DesktopName 3 Desktop 4
DesktopSize 1x1

# EdgeScroll will move the view port between the Pages when the mouse
# moves to the edge of the screen. This set the amount of distance to
# scroll at 100% (full page) and the EdgeResistance which is a timer
# for how long the mouse as at the edge before it scrolls.
#
# Set EdgeScroll 0 0 and/or EdgeResistance -1 to disable.
#EdgeScroll 100 100
EdgeScroll 0 0
#EdgeResistance 450
EdgeResistance -1
EdgeThickness 1
#Style * EdgeMoveDelay 350, EdgeMoveResistance 350

# EwmhBaseStruts [screen name] [left] [right] [top] [bottom]
# Reserves space along the edge(s) of the Screen that will not
# be covered when maximizing or placing windows.
#EwmhBaseStruts screen $[monitor.primary] 0 120 0 0
# This ist different for each Panel  

Read $[FVWM_USERDIR]/looklink/panel/style.config


# This sets the ClickTime and MoveThreshold used to determine
# Double Clicks, Hold and Move for the mouse.
ClickTime 250
MoveThreshold 3

# Sets the focus style to SloppyFocus and a mouse click
# in a window will Raise it.
Style * SloppyFocus, MouseFocusClickRaises
# Click to focus the window!
Style * ClickToFocus

# Default Font
#DefaultFont "xft:Sans:Bold:size=8:antialias=True"
DefaultFont "xft:Sans:size=10:antialias=True"

# Window Placement
#Style * MinOverlapPlacement, GrabFocusOff, !UsePPosition
Style * MinOverlapPlacement, !UsePPosition

# Sets all windows to OpaqueMove (vs a wired frame) and  windows will
# snap to each other and the edge of the screen.
OpaqueMoveSize unlimited
Style * ResizeOpaque, SnapAttraction 15 SameType ScreenAll, SnapGrid

# Transient Windows (such as open file windows)
Style * DecorateTransient, StackTransientParent
Style * !FPGrabFocusTransient, FPReleaseFocusTransient

# WindowShade
Style * WindowShadeScrolls, WindowShadeSteps 10

# Ignore Numlock and other modifiers for bindings
# See http://fvwm.org/documentation/faq/#why-do-numlock-capslock-and-scrolllock-interfere-with-clicktofocus-andor-my-mouse-bindings
IgnoreModifiers L25

# Decor Styles
#Style * BorderWidth 5, HandleWidth 5, MWMButtons, FvwmBorder, FirmBorder
## FirmBorder: brings the window to front by cklicking anywhere in the window 
Style * BorderWidth 7, HandleWidth 7, MWMButtons, MWMBorder, FirmBorder
Style * Colorset 1, HilightColorset 2

# BorderColorset and HilightBorderColorset take 8 positive colorsets
# to specify the colorset for each edge and handle (corner). The order is:
#   North NorthEast East SouthEast South SouthWest West NorthWest
# This makes the edges and corners (handles) different colors.
Style * BorderColorset 3 3 3 3 3 3 3 3
Style * HilightBorderColorset 4 4 4 4 4 4 4 4

# Disable Icons from appearing on desktop.
# Comment this out or use Style * Icon to get the icons back.
#Style * !Icon
Style * IconTitle
Style * IconTitleRelief 2
Style * IconTitleColorset 1
Style * HighlightIconTitleColorset 2
Style * IconBackgroundRelief 2
Style * IconBackgroundPadding 10
#Style * IconBackgroundColorset 1

#Style * IconOverride

## Set Unknowen Icons
#Style * Icon icons/big/app.png
## Set One Icon for all apps exept the special apps defined below
Style ** Icon $[FVWM_USERDIR]/my_icons/big/system.png

## Set Icons for special apps
Style xterm Icon $[FVWM_USERDIR]/my_icons/big/terminal.png, IconOverride
Style uxterm Icon $[FVWM_USERDIR]/my_icons/big/terminal.png, IconOverride


## Set MiniIcons for special apps
# MinIcons only be set if the app does not provide them
Style * MiniIcon $[FVWM_USERDIR]/my_icons/mini/system.png
Style xterm MiniIcon $[FVWM_USERDIR]/my_icons/mini/terminal.png
Style uxterm MiniIcon $[FVWM_USERDIR]/my_icons/mini/terminal.png


# Window Specific Styles
Style MainPanel !Title, !Borders, !Handles, Sticky, \
                 WindowListSkip, NeverFocus
Style ConfirmQuit !Title, PositionPlacement Center, WindowListSkip, Layer 6
Style FvwmIdent WindowListSkip
