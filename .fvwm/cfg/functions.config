###########
# 1: Functions
#
# Fvwm can use custom functions for various tasks.
# The syntax for defining a function named FunctionName is:
#
#   DestroyFunc FunctionName
#   AddToFunc FunctionName
#   + I [Action to do Immediately]
#   + C [Action to do on a Mouse Click]
#   + D [Action to do on a Mouse Double Click]
#   + H [Action to do on a Mouse Hold]
#   + M [Action to do on a Mouse Motion]
###########

# Start Function
#
# The start function is run right after fvwm is done reading
# the config file. This function run after each restart
# so using Test (Init) or Test (Restart) can further control
# actions that are run during the first time run (Init) or
# actions that are run after a restart.
DestroyFunc StartFunction
AddToFunc   StartFunction
+ I Test (Init) InitLook
+ I Test (Init) Exec exec volumeicon &
+ I Test (Init) Exec exec nm-applet &
+ I Test (Init) Exec exec xscreensaver &
+ I Test (Init) Exec exec conky
+ I InitBackground
+ I Module FvwmButtons MainPanel
+ I Module FvwmEvent EventNewDesk

# Function to set look when fvwm starts
DestroyFunc InitLook
AddToFunc InitLook
+ I Test (!f $[FVWM_USERDIR]/looklink) \
   Exec exec ln -fs look/default/ $[FVWM_USERDIR]/looklink
+ I TestRc (Match) Restart


# Function to set background when fvwm starts
DestroyFunc InitBackground
AddToFunc InitBackground
+ I Test (f $[FVWM_USERDIR]/looklink/bg.png) \
    Exec exec $[infostore.fvwm-root] $[FVWM_USERDIR]/looklink/bg.png
+ I TestRc (NoMatch) \
    Exec exec $[infostore.fvwm-root] $[FVWM_USERDIR]/look/default/bg_default.png


# Mouse Bindings Functions
DestroyFunc RaiseMoveX
AddToFunc RaiseMoveX
+ I Raise
+ M $0
+ D $1

DestroyFunc RaiseMove
AddToFunc RaiseMove
+ I Raise
+ M $0

DestroyFunc MoveToCurrent
AddToFunc MoveToCurrent
+ I ThisWindow MoveToPage
+ I ThisWindow MoveToDesk

# Function: ViewManPage $0
#
# This function loads the man page $0 in an terminal
# and is used with the help menu.
DestroyFunc ViewManPage
AddToFunc   ViewManPage
+ I Exec exec $[infostore.terminal] -g 80x40 \
  -n "Manual Page - $0" -T "Manual Page - $0" -e man "$0"


# Function: SetLook $0
#
# SetLook is used to set the look and feel
DestroyFunc SetLook
AddToFunc   SetLook
+ I Test (f $[FVWM_USERDIR]/look/$0) \
    Exec exec ln -fns look/$0/ $[FVWM_USERDIR]/looklink
+ I Exec exec xrdb -load ~/.Xresources
+ I Exec exec cp -f $[FVWM_USERDIR]/looklink/settings.ini ~/.config/gtk-3.0/settings.ini
+ I Exec exec cp -f $[FVWM_USERDIR]/looklink/look.el ~/.emacs.d/look.el
+ I InitBackground
+ I Restart



# Function: IconManClick
#
# This function is run from FvwmIconMan when the button is clicked.
DestroyFunc IconManClick
AddToFunc   IconManClick
+ I ThisWindow (Raised, !Shaded, !Iconic, CurrentPage, AnyScreen) Iconify
+ I TestRc (Match) Break
+ I ThisWindow WindowShade off
+ I ThisWindow Iconify off
+ I ThisWindow Raise
+ I ThisWindow (AcceptsFocus) FlipFocus

# Function: ToggleTitle
#
# This function will toggle if fvwm shows the TitleBar.
DestroyFunc ToggleTitle
AddToFunc   ToggleTitle
+ I ThisWindow (HasTitle) WindowStyle !Title
+ I TestRc (NoMatch) WindowStyle Title

# Function: ChangeDesk
#
# This function is called by FvwmEvent every time the Desk is changed.
DestroyFunc ChangeDesk
AddToFunc   ChangeDesk
+ I SendToModule FvwmButtons ChangeButton desk0 Colorset 0
+ I SendToModule FvwmButtons ChangeButton desk1 Colorset 15
+ I SendToModule FvwmButtons ChangeButton desk2 Colorset 16
+ I SendToModule FvwmButtons ChangeButton desk3 Colorset 9
+ I SendToModule FvwmButtons ChangeButton desk$0 Colorset 11
