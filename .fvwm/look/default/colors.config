########
# Colorset: Art-Deco theme Blue Dark
########

SetEnv C_WHITE          white
SetEnv C_BLACK          black
SetEnv C_SKY_BLUE       #4781ff
SetEnv C_STEEL_BLUE     #2b4e5e
SetEnv C_SEE_BLUE       #1a6e99
SetEnv C_CYAN_GREY      #88b2b1
SetEnv C_GREEN_GREY     #cbdcca
SetEnv C_DARK_GREY      #999999
SetEnv C_LIGHT_MAGENTA  #ff7dae
SetEnv C_MAGENTA        #ce42d5
SetEnv C_LIGHT_CYAN     #7be9db
SetEnv C_CYAN           #00ffff


# Default : ONE
Colorset 0  fg $[C_SKY_BLUE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Inactive Windows
Colorset 1  fg $[C_LIGHT_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Active Window
Colorset 2  fg $[C_CYAN], bg $[C_SEE_BLUE], hi, sh, Plain, NoShape

# Inactive Windows Borders
Colorset 3  fg $[C_WHITE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Active Window Borders
Colorset 4  fg $[C_WHITE], bg $[C_SEE_BLUE], hi, sh, Plain, NoShape

# Menu - Inactive Item
Colorset 5  fg $[C_BLACK], bg $[C_GREEN_GREY], hi, sh, Plain, NoShape

# Menu - Active Item
Colorset 6 fg $[C_BLACK], bg $[C_CYAN_GREY], hi, sh, Plain, NoShape

# Menu - Grayed Item
Colorset 7 fg $[C_DARK_GREY], bg $[C_GREEN_GREY], hi, sh, Plain, NoShape

# Menu - Title
Colorset 8  fg $[C_WHITE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Reserved: FOUR
Colorset 9  fg $[C_MAGENTA], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Module Default
Colorset 10  fg $[C_LIGHT_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Module Hilight
Colorset 11  fg $[C_CYAN], bg $[C_SEE_BLUE], hi, sh, Plain, NoShape

# Module ActiveButton (Mouse Hover)
Colorset 12  fg $[C_CYAN], bg $[C_SEE_BLUE], hi, sh, Plain, NoShape

# FvwmPager Active Page
Colorset 13  fg $[C_WHITE], bg $[C_LIGHT_MAGENTA], hi, sh, Plain, NoShape

# FvwmIconMan Iconified Button
Colorset 14  fg $[C_SKY_BLUE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# TWO
Colorset 15  fg $[C_LIGHT_MAGENTA], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# THREE
Colorset 16  fg $[C_LIGHT_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape
