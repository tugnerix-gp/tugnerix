########
# Colorset: Amiga OS 2.0 (3.0) 
########

SetEnv C_WHITE          white
SetEnv C_BLACK          black
SetEnv C_LIGHT_GREY     #aeaeae
SetEnv C_DARK_GREY      #888888
SetEnv C_LIGHT_BLUE     #6e8ebe


# Default : ONE
Colorset 0  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# Inactive Windows
Colorset 1  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Active Window
Colorset 2  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# Inactive Windows Borders
Colorset 3  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Active Window Borders
Colorset 4  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# Menu - Inactive Item
Colorset 5  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Menu - Active Item
Colorset 6 fg $[C_BLACK], bg $[C_WHITE], hi, sh, Plain, NoShape

# Menu - Grayed Item
Colorset 7 fg $[C_LIGHT_GREY], bg $[C_DARK_GREY], hi, sh, Plain, NoShape

# Menu - Title
Colorset 8  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# Reserved: FOUR
Colorset 9  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# Module Default
Colorset 10  fg $[C_BLACK], bg $[C_DARK_GREY], hi, sh, Plain, NoShape

# Module Hilight
Colorset 11  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Module ActiveButton (Mouse Hover)
Colorset 12  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# FvwmPager Active Page
Colorset 13  fg $[C_WHITE], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# FvwmIconMan Iconified Button
Colorset 14  fg $[C_LIGHT_GREY], bg $[C_DARK_GREY], hi, sh, Plain, NoShape

# TWO
Colorset 15  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape

# THREE
Colorset 16  fg $[C_BLACK], bg $[C_LIGHT_BLUE], hi, sh, Plain, NoShape
