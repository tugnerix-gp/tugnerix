########
# Colorset: Art-Deco theme Neon
########

SetEnv C_WHITE          white
SetEnv C_BLACK          black
SetEnv C_BRIGHT_BLUE    #00bff7
SetEnv C_CYAN           #00fefc
SetEnv C_STEEL_BLUE     #2b4e5e
SetEnv C_BRIGHT_TEAL    #06faca
SetEnv C_PALE_MAUVE     #fccffc
SetEnv C_YELLOWISH_TAN  #e8ea6b


#SetEnv C_DARK_GREY      #888888
#SetEnv C_AQUA_BLUE      #00c6d3
#SetEnv C_PETROL         #016c7c
#SetEnv C_DARK_BLUE_GREY #0c203b
#SetEnv C_CHARCOAL_GREYY #3a3d44
#SetEnv C_OCEAN_GREEN    #38a57f
#SetEnv C_TOPAZ          #34d6c9
#SetEnv C_LIGHT_PINK     #ebccd2
#SetEnv C_BRIGHT_CYAN    #5af3f5
#SetEnv C_SUNNY_YELLOW   #fff91d


# Default : ONE
Colorset 0  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Inactive Windows
Colorset 1  fg $[C_STEEL_BLUE], bg $[C_BRIGHT_BLUE], hi, sh, Plain, NoShape

# Active Window
Colorset 2  fg $[C_BLACK], bg $[C_BRIGHT_TEAL], hi, sh, Plain, NoShape

# Inactive Windows Borders
Colorset 3  fg $[C_STEEL_BLUE], bg $[C_BRIGHT_BLUE], hi, sh, Plain, NoShape

# Active Window Borders
Colorset 4  fg $[C_DARK_GREY], bg $[C_BRIGHT_TEAL], hi, sh, Plain, NoShape

# Menu - Inactive Item
Colorset 5  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Menu - Active Item
Colorset 6 fg $[C_BLACK], bg $[C_CYAN], hi, sh, Plain, NoShape

# Menu - Grayed Item
Colorset 7 fg $[C_SKY_BLUE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Menu - Title
Colorset 8  fg $[C_BLACK], bg $[C_CYAN], hi, sh, Plain, NoShape

# Reserved: FOUR
Colorset 9  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Module Default
Colorset 10  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# Module Hilight
Colorset 11  fg $[C_BLACK], bg $[C_YELLOWISH_TAN], hi, sh, Plain, NoShape

# Module ActiveButton (Mouse Hover)
Colorset 12  fg $[C_BLACK], bg $[C_CYAN], hi, sh, Plain, NoShape

# FvwmPager Active Page
Colorset 13  fg $[C_WHITE], bg $[C_PALE_MAUVE], hi, sh, Plain, NoShape

# FvwmIconMan Iconified Button
Colorset 14  fg $[C_PALE_MAUVE], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# TWO
Colorset 15  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape

# THREE
Colorset 16  fg $[C_CYAN], bg $[C_STEEL_BLUE], hi, sh, Plain, NoShape
