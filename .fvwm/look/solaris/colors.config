########
# Colorset: SUN Solaris
########

SetEnv C_WHITE          white
SetEnv C_BLACK          black
SetEnv C_DARK_GREY      #999999
SetEnv C_LIGHT_GREY     #aeb2c3
SetEnv C_PINK           #b24d7a
SetEnv C_LILA           #63639c



# Default : ONE
Colorset 0  fg $[C_WHITE], bg $[C_LILA], hi, sh, Plain, NoShape

# Inactive Windows
Colorset 1  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Active Window
Colorset 2  fg $[C_WHITE], bg $[C_PINK], hi, sh, Plain, NoShape

# Inactive Windows Borders
Colorset 3  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Active Window Borders
Colorset 4  fg $[C_WHITE], bg $[C_PINK], hi, sh, Plain, NoShape

# Menu - Inactive Item
Colorset 5  fg $[C_BLACK], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Menu - Active Item
Colorset 6 fg $[C_BLACK], bg $[C_PINK], hi, sh, Plain, NoShape

# Menu - Grayed Item
Colorset 7 fg $[C_DARK_GREY], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Menu - Title
Colorset 8  fg $[C_WHITE], bg $[C_LILA], hi, sh, Plain, NoShape

# Reserved: FOUR
Colorset 9  fg $[C_WHITE], bg $[C_LILA], hi, sh, Plain, NoShape

# Module Default
Colorset 10  fg $[C_WHITE], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# Module Hilight
Colorset 11  fg $[C_WHITE], bg $[C_PINK], hi, sh, Plain, NoShape

# Module ActiveButton (Mouse Hover)
Colorset 12  fg $[C_WHITE], bg $[C_PINK], hi, sh, Plain, NoShape

# FvwmPager Active Page
Colorset 13  fg $[C_WHITE], bg $[C_PINK], hi, sh, Plain, NoShape

# FvwmIconMan Iconified Button
Colorset 14  fg $[C_LILA], bg $[C_LIGHT_GREY], hi, sh, Plain, NoShape

# TWO
Colorset 15  fg $[C_WHITE], bg $[C_LILA], hi, sh, Plain, NoShape

# THREE
Colorset 16  fg $[C_WHITE], bg $[C_LILA], hi, sh, Plain, NoShape
